<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>AcroCatPdfEditor</AssemblyName>
    <RootNamespace>AcrobatPdfEditor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\ArcoCatIcon.ico</ApplicationIcon>
    <Product>ArcoCat PDF Editor</Product>
    <Title>ArcoCat PDF Editor</Title>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ArcoCatIcon.png" />
    <Resource Include="Assets\ArcoCatIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="PDFtoImage" Version="4.0.2" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

</Project>
