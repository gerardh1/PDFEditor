<Window x:Class="AcrobatPdfEditor.Views.SignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArcoCat PDF Editor — Fill &amp; Sign Signature"
        Icon="pack://application:,,,/Assets/ArcoCatIcon.ico"
        Width="520" Height="390"
        MinWidth="460" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1E222A"
        Foreground="#F0F4F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Create Your Digital Signature" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Draw your signature with the mouse or type your full name below, then click Apply to place it on the page."
                       FontSize="12" Foreground="#9AA5B4" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Mode & Color Selector -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <RadioButton x:Name="DrawModeRadio" Content="Draw Signature" IsChecked="True"
                             Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,0,16,0"
                             Checked="ModeRadio_Checked"/>
                <RadioButton x:Name="TypeModeRadio" Content="Type Signature"
                             Foreground="#E2E8F0" FontWeight="SemiBold"
                             Checked="ModeRadio_Checked"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="Ink:" VerticalAlignment="Center" Foreground="#9AA5B4" Margin="0,0,6,0"/>
                <ComboBox x:Name="InkColorCombo" Width="115" SelectedIndex="1" SelectionChanged="InkColorCombo_SelectionChanged">
                    <ComboBoxItem Content="Black Ink" Tag="#111827"/>
                    <ComboBoxItem Content="Navy Blue" Tag="#0D47A1"/>
                    <ComboBoxItem Content="Crimson Red" Tag="#B71C1C"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Signature Pad Area -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" BorderBrush="#3B4252" BorderThickness="1.5" ClipToBounds="True">
            <Grid>
                <!-- Baseline guide -->
                <Line X1="24" Y1="145" X2="455" Y2="145" Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="4 3"/>
                <TextBlock Text="Sign Here" Foreground="#94A3B8" FontSize="11" Margin="26,150,0,0" VerticalAlignment="Top"/>

                <!-- Draw Canvas -->
                <Canvas x:Name="SignatureCanvas" Background="Transparent" Cursor="Pen"
                        MouseLeftButtonDown="SignatureCanvas_MouseLeftButtonDown"
                        MouseMove="SignatureCanvas_MouseMove"
                        MouseLeftButtonUp="SignatureCanvas_MouseLeftButtonUp"/>

                <!-- Typed Signature Panel -->
                <Grid x:Name="TypedSignaturePanel" Visibility="Collapsed" Background="#FFFFFF">
                    <StackPanel VerticalAlignment="Center" Margin="24,0">
                        <TextBlock Text="Enter Your Name:" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TypedNameBox" Text="Alex Morgan" FontSize="14" Padding="6,4"
                                 TextChanged="TypedNameBox_TextChanged"/>
                        <Border Margin="0,14,0,0" Padding="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                            <TextBlock x:Name="TypedPreviewText" Text="Alex Morgan"
                                       FontFamily="Times New Roman" FontSize="34" FontStyle="Italic" FontWeight="Bold"
                                       Foreground="#0D47A1" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button Content="Clear Pad" Width="95" Height="32" HorizontalAlignment="Left"
                    Background="#2D333F" Foreground="#E2E8F0" BorderThickness="0"
                    Click="ClearButton_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="32" Margin="0,0,10,0"
                        Background="#2D333F" Foreground="#E2E8F0" BorderThickness="0"
                        Click="CancelButton_Click"/>
                <Button Content="Apply Signature" Width="135" Height="32"
                        Background="#E53935" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="ApplyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
